{
  "appId": "com.magicfloor.dynamicruntime",
  "productName": "MagicFloor Dynamic Player",
  "executableName": "MagicFloor Dynamic Player Vertical Flip",
  "artifactName": "MagicFloor Dynamic Player Vertical Flip ${version}.${ext}",
  "directories": {
    "output": "release-vertical-flip"
  },
  "electronDist": "node_modules/electron/dist",
  "extraMetadata": {
    "main": "main.vertical-flip.js"
  },
  "files": [
    "main.js",
    "main.vertical-flip.js",
    "runtime-display-settings-core.cjs",
    "group-state-revision-core.cjs",
    "preload.js",
    "renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  }
}

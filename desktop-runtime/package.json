{
  "name": "magicfloor-dynamic-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "MagicFloor dynamic art desktop player runtime.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:appearance": "node --no-warnings scripts/verify-advanced-appearance.mjs",
    "test:item-copy": "node scripts/verify-item-settings-copy.cjs",
    "test:target-motion": "node --no-warnings scripts/verify-target-motion.mjs",
    "test:transition-audio": "node --no-warnings scripts/verify-background-transition-audio.mjs",
    "test:background-order": "node --no-warnings scripts/verify-background-playback-order.mjs",
    "test:presentation": "node --no-warnings --test runtime-display-settings-core.test.cjs renderer/stage-presentation-core.test.mjs",
    "clean:releases": "node scripts/clean-release-directories.cjs all",
    "clean:release:standard": "node scripts/clean-release-directories.cjs standard",
    "clean:release:vertical": "node scripts/clean-release-directories.cjs vertical",
    "prepack:dir": "npm run clean:release:standard",
    "pack:dir": "electron-builder --win dir",
    "prepack:portable": "npm run clean:release:standard",
    "pack:portable": "electron-builder --win portable",
    "prepack:vertical-flip": "npm run clean:release:vertical",
    "pack:vertical-flip": "electron-builder --config electron-builder.vertical-flip.json --win",
    "pack:all": "npm run pack:portable && npm run pack:vertical-flip"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.magicfloor.dynamicruntime",
    "productName": "MagicFloor Dynamic Player",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "main.vertical-flip.js",
      "runtime-display-settings-core.cjs",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
